# AXIO Shield — configuración. Copiá a .env y ajustá.
# Todas las variables usan el prefijo SHIELD_.

# --- Claude API ---
# Vacío  -> MODO STUB: la demo corre offline, determinista, sin gastar tokens.
# Con key -> usa Claude real (Haiku para volumen, Sonnet para TRACKER).
SHIELD_ANTHROPIC_API_KEY=

# Forzar modo stub aunque haya API key (demos offline reproducibles): 1 o 0
SHIELD_FORCE_STUB=0

# IDs de modelo (configurables por si cambian)
SHIELD_MODEL_HAIKU=claude-haiku-4-5-20251001
SHIELD_MODEL_SONNET=claude-sonnet-5

# --- Servidor ---
# CORS: en producción, restringir al dominio del portal (ej. https://portal.banco.com)
SHIELD_CORS_ORIGINS=*
SHIELD_DB_PATH=shield.db

# --- Alertas (opcional) ---
# Si se define, HERALD hace POST del incidente a este webhook (Slack/SOC).
SHIELD_WEBHOOK_URL=
